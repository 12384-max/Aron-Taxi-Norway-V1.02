# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# STRIPE_SECRET_KEY: Secret key from Stripe Dashboard (e.g. sk_test_... or sk_live_...)
# Used strictly on backend server to create Stripe Checkout sessions and verify payments.
STRIPE_SECRET_KEY="sk_test_..."

# STRIPE_WEBHOOK_SECRET: Webhook signing secret from Stripe Dashboard (e.g. whsec_...)
# Used to verify incoming Stripe webhook events on /api/stripe-webhook
STRIPE_WEBHOOK_SECRET="whsec_..."

# VITE_STRIPE_PUBLISHABLE_KEY: Public key for client-side badge/mode identification (e.g. pk_test_... or pk_live_...)
VITE_STRIPE_PUBLISHABLE_KEY="pk_test_..."

# NETS_SECRET_KEY: Nets Easy / Nexi Checkout Secret API key (test-secret-key-... or live-secret-key-...)
NETS_SECRET_KEY="test-secret-key-..."

# NETS_CHECKOUT_KEY: Nets Easy Checkout Key for frontend SDK (test-checkout-key-... or live-checkout-key-...)
NETS_CHECKOUT_KEY="test-checkout-key-..."

# NETS_ENVIRONMENT: "test" for test.api.dibspayment.eu, "live" for api.dibspayment.eu
NETS_ENVIRONMENT="test"

# VITE_NETS_CHECKOUT_KEY: Client-side public key for Nets Easy embedded iframe
VITE_NETS_CHECKOUT_KEY="test-checkout-key-..."

# VITE_API_BASE_URL: Optional backend API URL (useful when frontend is hosted statically on custom domain)
VITE_API_BASE_URL=

