# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# STRIPE_SECRET_KEY: Secret key from Stripe Dashboard (e.g. sk_test_... or sk_live_...)
# Used strictly on backend server to create Stripe Checkout sessions and verify payments.
STRIPE_SECRET_KEY="sk_test_..."

# STRIPE_WEBHOOK_SECRET: Webhook signing secret from Stripe Dashboard (e.g. whsec_...)
# Used to verify incoming Stripe webhook events on /api/stripe-webhook
STRIPE_WEBHOOK_SECRET="whsec_..."

# VITE_STRIPE_PUBLISHABLE_KEY: Public key for client-side badge/mode identification (e.g. pk_test_... or pk_live_...)
VITE_STRIPE_PUBLISHABLE_KEY="pk_test_..."

# NETS_SECRET_KEY: Nets Easy / Nexi Checkout Secret API key (test-secret-key-... or live-secret-key-...)
NETS_SECRET_KEY=

# NETS_CHECKOUT_KEY: Nets Easy Checkout Key (test-checkout-key-... or live-checkout-key-...)
NETS_CHECKOUT_KEY=

# NETS_ENVIRONMENT: "test" for development/testing (test.api.dibspayment.eu), "live" for production (api.dibspayment.eu)
NETS_ENVIRONMENT="test"

# NETS_WEBHOOK_SECRET: Secret authorization token used to verify Nets Easy webhook events
NETS_WEBHOOK_SECRET=

# VITE_NETS_CHECKOUT_KEY: Client-side public key for Nets Easy
VITE_NETS_CHECKOUT_KEY=

# VITE_API_BASE_URL: Optional backend API URL (useful when frontend is hosted statically on custom domain)
VITE_API_BASE_URL=

# VIPPS MOBILEPAY E-PAYMENT CONFIGURATION
# VIPPS_CLIENT_ID: Client ID from Vipps Developer Portal
VIPPS_CLIENT_ID="your-vipps-client-id"

# VIPPS_CLIENT_SECRET: Client Secret from Vipps Developer Portal
VIPPS_CLIENT_SECRET="your-vipps-client-secret"

# VIPPS_SUBSCRIPTION_KEY: Ocp-Apim-Subscription-Key from Vipps Developer Portal
VIPPS_SUBSCRIPTION_KEY="your-vipps-subscription-key"

# VIPPS_MERCHANT_SERIAL_NUMBER: Vipps MSN (Merchant Serial Number, e.g. 6-digit number)
VIPPS_MERCHANT_SERIAL_NUMBER="your-vipps-msn"

# VIPPS_ENVIRONMENT: "test" for https://apitest.vipps.no, "live" for https://api.vipps.no
VIPPS_ENVIRONMENT="test"


